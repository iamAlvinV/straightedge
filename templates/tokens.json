{
  "$description": "Straightedge token starter, W3C DTCG format. Three tiers: primitives, semantic, component. Example values are the IamAlvinV palette; replace with your brand and rerun scripts/contrast.py on every text pairing. Designed by IamAlvinV.",
  "color": {
    "paper": { "100": { "$type": "color", "$value": "#E9E7DE" }, "50": { "$type": "color", "$value": "#F2F0E9" } },
    "ink":   { "900": { "$type": "color", "$value": "#0F0E0C" }, "700": { "$type": "color", "$value": "#35332E" } },
    "lime":  { "500": { "$type": "color", "$value": "#C6E220" } },
    "coral": { "500": { "$type": "color", "$value": "#DE7256" } }
  },
  "semantic": {
    "surface":    { "$type": "color", "$value": "{color.paper.100}" },
    "surface-2":  { "$type": "color", "$value": "{color.paper.50}" },
    "text":       { "$type": "color", "$value": "{color.ink.900}" },
    "text-muted": { "$type": "color", "$value": "{color.ink.700}" },
    "accent":     { "$type": "color", "$value": "{color.lime.500}" },
    "accent-2":   { "$type": "color", "$value": "{color.coral.500}" }
  },
  "component": {
    "button-bg":   { "$type": "color", "$value": "{semantic.accent}" },
    "button-text": { "$type": "color", "$value": "{semantic.text}" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Anton", "sans-serif"] },
    "body":    { "$type": "fontFamily", "$value": ["Archivo", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["Space Mono", "monospace"] }
  },
  "dimension": {
    "space": {
      "1": { "$type": "dimension", "$value": "8px" },
      "2": { "$type": "dimension", "$value": "16px" },
      "3": { "$type": "dimension", "$value": "24px" },
      "4": { "$type": "dimension", "$value": "32px" },
      "6": { "$type": "dimension", "$value": "48px" },
      "8": { "$type": "dimension", "$value": "64px" }
    },
    "radius": { "$type": "dimension", "$value": "0px" }
  }
}
